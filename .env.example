# URL pubblico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Facoltativo: sovrascrive l'URL senza rifare la build (utile con il tunnel Cloudflare)
SITE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave segreta: solo lato server, mai esporla nel browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Email della piattaforma (nuova traccia, correzione, messaggi, promemoria).
# Brevo › SMTP & API › API Keys. In alternativa RESEND_API_KEY. Senza chiave le email non partono.
BREVO_API_KEY=
RESEND_API_KEY=
# Deve essere un mittente verificato su Brevo
EMAIL_FROM="Pronao <notifiche@tuodominio.it>"

# Bunny Stream: caricamento e streaming dei video (bunny.net › Stream › la tua libreria)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security › Token authentication › chiave (consigliato: i link del player scadono dopo poche ore)
BUNNY_STREAM_TOKEN_KEY=
# Stringa casuale da aggiungere all'URL del webhook Bunny (?secret=...)
BUNNY_WEBHOOK_SECRET=

# Promemoria automatici del giorno prima (Vercel Cron). Stringa casuale lunga.
CRON_SECRET=

# Canale YouTube della scuola (galleria dei video nel modulo lezione).
# Stesso progetto Google Cloud del login: client OAuth "Applicazione web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facoltativo: chiave per cifrare il token del canale (stringa casuale lunga)
INTEGRATIONS_SECRET=
# Facoltativo: hostname CDN della libreria Bunny (es. vz-abc123.b-cdn.net) per le miniature delle lezioni
BUNNY_STREAM_CDN_HOSTNAME=
# Facoltativo: codice di verifica di Google Search Console (solo il valore di content="...")
GOOGLE_SITE_VERIFICATION=
# In alternativa al tag: nome del file di verifica scaricato da Search Console (es. google1a2b3c4d.html)
GOOGLE_SITE_VERIFICATION_FILE=
# Correzione sul documento: conversione dei file Word in PDF (cloudconvert.com › Dashboard › API Keys,
# permessi: task.read, task.write). Senza chiave i PDF si correggono comunque; i Word no.
CLOUDCONVERT_API_KEY=
